<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.1/firebase-app.js";
import { getFirestore, collection, doc, onSnapshot, setDoc, deleteDoc }
  from "https://www.gstatic.com/firebasejs/12.12.1/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyAeHWuMhz6ct9iG4HKmR_2xtn7_IpuNAr4",
  authDomain: "omni-cc5fa.firebaseapp.com",
  projectId: "omni-cc5fa",
  storageBucket: "omni-cc5fa.firebasestorage.app",
  messagingSenderId: "480869318348",
  appId: "1:480869318348:web:4b11a90feecb88f8e0cc69"
};

const app = initializeApp(firebaseConfig);
const db  = getFirestore(app);
const COL = 'menachemnewbuiz';

// ── State ──
let records    = [];
let editingId  = null;
let sortCol    = 'effectiveDate';
let sortDir    = 1;
let pending    = [];
let undoFn     = null;
let undoTimer  = null;

// ── Expose to global ──
window.renderTable  = renderTable;
window.sortBy       = sortBy;
window.openAdd      = openAdd;
window.closeModal   = closeModal;
window.saveEntry    = saveEntry;
window.editEntry    = editEntry;
window.deleteEntry  = deleteEntry;
window.closePreview = closePreview;
window.confirmImport = confirmImport;
window.handleFile   = handleFile;
window.doUndo       = doUndo;

// ── Helpers ──
function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function uid(){ return Date.now().toString(36)+Math.random().toString(36).slice(2); }
function setSyncing(v){
  const d=document.getElementById('sync-dot'), l=document.getElementById('sync-label');
  if(d) d.classList.toggle('syncing',v);
  if(l) l.textContent = v ? 'Saving…' : 'Live sync';
}
function showUndo(msg, fn){
  if(undoTimer) clearTimeout(undoTimer);
  undoFn = fn;
  const t=document.getElementById('undo-toast');
  document.getElementById('undo-msg').textContent = msg;
  t.classList.add('show');
  undoTimer = setTimeout(()=>{ t.classList.remove('show'); undoFn=null; }, 6000);
}
function doUndo(){ if(undoFn){ undoFn(); undoFn=null; } document.getElementById('undo-toast').classList.remove('show'); if(undoTimer) clearTimeout(undoTimer); }

// ── Firebase listener ──
onSnapshot(collection(db, COL), snap => {
  records = snap.docs.map(d => ({ id: d.id, ...d.data() }));
  renderTable();
  renderStats();
  document.getElementById('loading-screen').style.display = 'none';
});

// ── Stats ──
function renderStats(){
  const total = records.length;
  const csrs  = new Set(records.map(r=>r.csr).filter(Boolean)).size;
  const clients = new Set(records.map(r=>r.clientName).filter(Boolean)).size;
  document.getElementById('stat-total').textContent   = total;
  document.getElementById('stat-csrs').textContent    = csrs;
  document.getElementById('stat-clients').textContent = clients;
  document.getElementById('header-count').textContent = total;
}

// ── Render table ──
function renderTable(){
  const search = (document.getElementById('search').value||'').toLowerCase();
  const csrF   = (document.getElementById('csr-filter').value||'').toLowerCase();

  let filtered = records.filter(r => {
    const ms = !search ||
      (r.clientName||'').toLowerCase().includes(search) ||
      (r.csr||'').toLowerCase().includes(search) ||
      (r.notes||'').toLowerCase().includes(search);
    const mc = !csrF || (r.csr||'').toLowerCase() === csrF;
    return ms && mc;
  });

  filtered.sort((a,b) => {
    let va = (a[sortCol]||'').toString().toLowerCase();
    let vb = (b[sortCol]||'').toString().toLowerCase();
    return va < vb ? -sortDir : va > vb ? sortDir : 0;
  });

  // CSR filter dropdown
  const csrs = [...new Set(records.map(r=>r.csr).filter(Boolean))].sort();
  const sel  = document.getElementById('csr-filter');
  const cur  = sel.value;
  sel.innerHTML = '<option value="">All CSRs</option>' +
    csrs.map(c=>`<option value="${c.toLowerCase()}"${cur===c.toLowerCase()?' selected':''}>${esc(c)}</option>`).join('');

  const tbody = document.getElementById('table-body');
  const empty = document.getElementById('empty-state');

  if(filtered.length === 0){
    tbody.innerHTML = '';
    empty.style.display = records.length === 0 ? 'block' : 'none';
    return;
  }
  empty.style.display = 'none';

  tbody.innerHTML = filtered.map(r => `
    <tr>
      <td class="col-csr">${esc(r.csr||'—')}</td>
      <td class="col-client">${esc(r.clientName||'—')}</td>
      <td class="col-date">${esc(r.effectiveDate||'—')}</td>
      <td class="col-notes">${esc(r.notes||'—')}</td>
      <td class="col-actions">
        <div class="action-col">
          <button class="edit-btn" onclick="editEntry('${r.id}')">Edit</button>
          <button class="del-btn" onclick="deleteEntry('${r.id}')">×</button>
        </div>
      </td>
    </tr>
  `).join('');
}

// ── Sort ──
function sortBy(col){
  if(sortCol===col) sortDir=-sortDir; else { sortCol=col; sortDir=1; }
  ['csr','clientName','effectiveDate'].forEach(c=>{
    const el=document.getElementById('sort-'+c);
    if(el) el.textContent = c===col ? (sortDir===1?'↑':'↓') : '↕';
  });
  renderTable();
}

// ── Add / Edit Modal ──
function openAdd(){
  editingId = null;
  document.getElementById('modal-title').textContent = 'Add Entry';
  ['f-csr','f-client','f-date','f-notes'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('modal').classList.remove('hidden');
  setTimeout(()=>document.getElementById('f-client').focus(), 60);
}
function editEntry(id){
  const r = records.find(x=>x.id===id); if(!r) return;
  editingId = id;
  document.getElementById('modal-title').textContent = 'Edit Entry';
  document.getElementById('f-csr').value   = r.csr||'';
  document.getElementById('f-client').value = r.clientName||'';
  document.getElementById('f-date').value  = r.effectiveDate||'';
  document.getElementById('f-notes').value = r.notes||'';
  document.getElementById('modal').classList.remove('hidden');
}
function closeModal(){ document.getElementById('modal').classList.add('hidden'); }

async function saveEntry(){
  const entry = {
    csr:           document.getElementById('f-csr').value.trim(),
    clientName:    document.getElementById('f-client').value.trim(),
    effectiveDate: document.getElementById('f-date').value.trim(),
    notes:         document.getElementById('f-notes').value.trim(),
  };
  if(!entry.clientName && !entry.csr) return;
  setSyncing(true);
  try {
    const id = editingId || uid();
    await setDoc(doc(db, COL, id), { ...entry, id });
  } finally { setSyncing(false); }
  closeModal();
}

async function deleteEntry(id){
  const r = records.find(x=>x.id===id); if(!r) return;
  const snap = {...r};
  setSyncing(true);
  await deleteDoc(doc(db, COL, id));
  setSyncing(false);
  showUndo(esc(snap.clientName||'Entry')+' deleted', async()=>{
    setSyncing(true);
    await setDoc(doc(db, COL, snap.id), snap);
    setSyncing(false);
  });
}

// ── Docx Upload ──
async function handleFile(input){
  const file = input.files[0]; if(!file) return;
  await parseDocx(file);
  input.value='';
}

const zone = document.getElementById('upload-zone');
zone.addEventListener('dragover', e=>{ e.preventDefault(); zone.classList.add('drag-over'); });
zone.addEventListener('dragleave', ()=>zone.classList.remove('drag-over'));
zone.addEventListener('drop', async e=>{
  e.preventDefault(); zone.classList.remove('drag-over');
  const file = e.dataTransfer.files[0];
  if(file && file.name.endsWith('.docx')) await parseDocx(file);
  else alert('Please drop a .docx Word file.');
});

async function parseDocx(file){
  try {
    const buf = await file.arrayBuffer();
    if(!window.mammoth){ alert('Parser still loading, please try again in a moment.'); return; }
    const result = await window.mammoth.extractRawText({ arrayBuffer: buf });
    const rows = textToRows(result.value);
    if(rows.length===0){ alert('No entries found. The document may be empty or formatted unexpectedly.'); return; }
    showPreview(rows);
  } catch(err){
    console.error(err);
    alert('Could not read the file. Make sure it is a valid .docx Word document.');
  }
}

function textToRows(text){
  const csrNames = ['menachem','mendy','hannah','israel','wilson','yitz','stuart','ben','mathew','matthew','mrs. ruben'];
  const lines = text.split('\n').map(l=>l.trim()).filter(Boolean);
  const rows  = [];

  for(const line of lines){
    if(/^\d{1,2}\/\d{1,2}\s+new business/i.test(line)) continue;
    if(line.length < 5) continue;
    const clean = line.replace(/^[-–•*]\s*/,'').trim();
    if(!clean) continue;

    let clientName='', notes=clean, csr='', effectiveDate='';

    const dashIdx = clean.search(/[-–]/);
    if(dashIdx > 0){ clientName=clean.substring(0,dashIdx).trim(); notes=clean.substring(dashIdx+1).trim(); }
    else { const w=clean.split(' '); clientName=w.slice(0,2).join(' '); notes=w.slice(2).join(' '); }

    const dm = clean.match(/\b(\d{1,2}\/\d{1,2}(?:\/?\s*\d{2,4})?)\b/g);
    if(dm) effectiveDate = dm[dm.length-1];

    const cm = clean.match(/[-–]\s*([A-Za-z\/]+)\s*$/);
    if(cm){ const c=cm[1].toLowerCase().replace('myself/','');
      if(csrNames.some(n=>c.includes(n))){ csr=cm[1].replace(/^myself\//i,'').trim(); notes=notes.replace(/[-–]\s*[A-Za-z\/]+\s*$/,'').trim(); }}
    const mm = clean.match(/myself\/(\w+)/i);
    if(mm && !csr) csr=mm[1];

    if(!clientName) continue;
    rows.push({ csr, clientName, effectiveDate, notes: notes||clean });
  }
  return rows;
}

// ── Import Preview ──
function showPreview(rows){
  pending = rows.map(r=>({...r}));
  document.getElementById('preview-count').textContent = rows.length+' entr'+(rows.length!==1?'ies':'y')+' found';
  document.getElementById('preview-body').innerHTML = rows.map((r,i)=>`
    <tr>
      <td><input value="${esc(r.csr)}" oninput="pending[${i}].csr=this.value" style="min-width:80px"/></td>
      <td><input value="${esc(r.clientName)}" oninput="pending[${i}].clientName=this.value" style="min-width:130px"/></td>
      <td><input value="${esc(r.effectiveDate)}" oninput="pending[${i}].effectiveDate=this.value" style="min-width:65px"/></td>
      <td><input value="${esc(r.notes)}" oninput="pending[${i}].notes=this.value"/></td>
    </tr>
  `).join('');
  document.getElementById('preview-modal').classList.remove('hidden');
}
function closePreview(){ document.getElementById('preview-modal').classList.add('hidden'); pending=[]; }

async function confirmImport(){
  if(!pending.length) return;
  const btn = document.querySelector('#preview-modal .btn-p');
  btn.textContent='Importing…'; btn.disabled=true;
  setSyncing(true);
  for(const entry of pending){
    if(!entry.clientName && !entry.csr) continue;
    const id = uid();
    await setDoc(doc(db, COL, id), { ...entry, id });
  }
  setSyncing(false);
  btn.textContent='⬆ Import All'; btn.disabled=false;
  closePreview();
}
